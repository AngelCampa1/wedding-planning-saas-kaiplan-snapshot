# Production: https://api.kaiplan.app
VITE_API_URL=http://localhost:5030
# Production: https://kaiplan.app
VITE_PUBLIC_SITE_URL=http://localhost:3031
# Production: Sentry dashboard app project DSN
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
# Ventora CRM feedback widget — authenticated surface only.
# Set to the product's widget public key issued by the CRM operator.
# Leave blank to disable the widget (safe in CI / feature-flag-off deploys).
VITE_CRM_WIDGET_KEY=
# Override the CRM loader URL (defaults to https://widgets.ventoralabs.com/w/v1.js)
VITE_CRM_LOADER_URL=https://widgets.ventoralabs.com/w/v1.js
