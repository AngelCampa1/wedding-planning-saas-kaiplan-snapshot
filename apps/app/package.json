{
  "name": "@kaiplan/app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm exec tsx ../../scripts/validate-cloudflare-app-config.ts && pnpm exec tsx ../../scripts/build-cloudflare-app.ts && pnpm exec wrangler deploy --config wrangler.jsonc",
    "lint": "pnpm exec eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --pool=forks --no-file-parallelism",
    "test:watch": "vitest",
    "test:coverage": "node scripts/run-coverage.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@kaiplan/knowledge": "workspace:*",
    "@kaiplan/shared": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.49.0",
    "@tanstack/react-query": "^5",
    "@tanstack/react-router": "^1",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460",
    "radix-ui": "^1.4.3",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.2.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/router-plugin": "^1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^4.1.3",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4",
    "typescript": "^5.7",
    "vite": "^6",
    "vitest": "^4.1.3",
    "wrangler": "^4.81.0"
  }
}
