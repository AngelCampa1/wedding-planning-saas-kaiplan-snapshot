---
export const prerender = true;
import "../../../styles/global.css";
import { getCollection, render } from "astro:content";
import LandingLayout from "@kaiplan/marketing/layouts/landing-layout.astro";
import BreadcrumbNav from "@kaiplan/marketing/components/breadcrumb-nav.astro";
import { siteConfig } from "@/config/site";
import { buildAlternativeRows } from "@/lib/comparison-rows";
import {
  buildContentMap,
  buildEntrySeoProps,
  resolveIndexableRelatedPageLinks,
} from "@/lib/page-helpers";
import { buildAppSignupUrl } from "@/lib/app-links";
import { contentEntrySlug } from "@/lib/content-entry";
import ResourcePillarLink from "@/components/resource-pillar-link.astro";
import { getPrimaryPillarForHref } from "@/lib/resource-pillars";
import { kaiplanPricingFacts } from "@kaiplan/knowledge/marketing";
import AiSeoBlocks from "@/components/ai-seo-blocks.astro";
import { buildEditorialSchemaGraph } from "@/lib/editorial-schema";

const { plans: PLAN_PRICING } = kaiplanPricingFacts;

export async function getStaticPaths() {
  const entries = await getCollection("pricing-breakdowns");
  return entries.map((entry) => ({
    params: { slug: contentEntrySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  description,
  bluf,
  publishedAt,
  updatedAt,
  buyerStage,
  competitor,
  tiers,
  hiddenCosts,
  faqs,
  relatedPages,
  tableData,
  pricingStats,
  answers,
  tags,
  expertQuotes,
  ogImage,
} = entry.data;
const canonicalPath = `/compare/pricing/${contentEntrySlug(entry)}`;
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Compare", href: "/compare/" },
  { label: "Pricing", href: "/compare/pricing/" },
  { label: title, href: `${canonicalPath}/` },
];
const primaryPillar = getPrimaryPillarForHref(canonicalPath);

const [
  alternatives,
  comparisons,
  pricingBreakdowns,
  listicles,
  guides,
  leadMagnets,
] = await Promise.all([
  getCollection("alternatives"),
  getCollection("comparisons"),
  getCollection("pricing-breakdowns"),
  getCollection("listicles"),
  getCollection("guides"),
  getCollection("lead-magnets"),
]);
const contentMap = buildContentMap({
  alternatives,
  comparisons,
  pricingBreakdowns,
  listicles,
  guides,
  leadMagnets,
});
const relatedLinks = resolveIndexableRelatedPageLinks(relatedPages, contentMap);

const pricingComparisonRows = buildAlternativeRows(
  competitor.name,
  competitor.pricing,
  siteConfig.product.price,
);
const seoProps = buildEntrySeoProps(entry.data);
const openAppUrl = buildAppSignupUrl();
const schemaGraph = buildEditorialSchemaGraph({
  title,
  description,
  publishedAt,
  updatedAt,
  canonicalPath,
  config: siteConfig,
  answers,
  faqs,
  breadcrumbs,
  ogImage,
});

// Resolve tier rows from tableData or tiers field
type TierRow = { name: string; price: string; features: string[] };
const tierRows: TierRow[] = tableData
  ? (tableData.rows ?? []).map((r: string[]) => ({
      name: r[0] ?? "",
      price: r[1] ?? "",
      features: r.slice(2),
    }))
  : (tiers ?? []).map((t: TierRow) => ({
      name: t.name,
      price: t.price,
      features: t.features ?? [],
    }));
---

<LandingLayout
  config={siteConfig}
  canonicalPath={canonicalPath}
  title={title}
  description={description}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  noindex={seoProps.noindex}
  ogType="article"
  buyerStage={buyerStage}
  articleTags={tags}
  schemaGraph={schemaGraph}
>
  <BreadcrumbNav
    items={breadcrumbs}
    siteUrl={`https://${siteConfig.domain}`}
    emitSchema={false}
  />
  <article class="editorial-shell" data-page="pricing-breakdown">
    <!-- HERO -->
    <section class="hero" aria-labelledby="pricing-headline">
      <p class="editorial-eyebrow">Pricing breakdown</p>
      <h1 id="pricing-headline" class="editorial-display-l hero__headline">
        <em>{competitor.name} pricing vs Kaiplan.</em>
      </h1>
      <p class="editorial-lede hero__lede">{description}</p>
    </section>

    <hr class="editorial-rule section-rule" aria-hidden="true" />

    <!-- PRICE AT A GLANCE -->
    <section class="price-glance" aria-labelledby="glance-heading">
      <h2 id="glance-heading" class="sr-only">Price at a glance</h2>
      <div class="price-glance__grid">
        <div class="price-glance__col">
          <p class="editorial-eyebrow price-glance__label">
            {competitor.name}
          </p>
          <p class="price-glance__amount">{competitor.pricing}</p>
        </div>
        <div class="price-glance__divider" aria-hidden="true">vs</div>
        <div class="price-glance__col">
          <p class="editorial-eyebrow price-glance__label">{siteConfig.name}</p>
          <p class="price-glance__amount price-glance__amount--kaiplan">
            {siteConfig.product.price}
          </p>
          <p class="editorial-caption price-glance__sub">
            or {PLAN_PRICING.lifetime.price}
          </p>
        </div>
      </div>
    </section>

    <hr class="editorial-rule section-rule" aria-hidden="true" />

    <!-- BLUF / OPENING STATEMENT -->
    {
      bluf && (
        <section class="bluf-section" aria-labelledby="bluf-heading">
          <h2 id="bluf-heading" class="sr-only">
            Summary
          </h2>
          <blockquote class="editorial-pullquote bluf-quote">{bluf}</blockquote>
        </section>
      )
    }

    {bluf && <hr class="editorial-rule section-rule" aria-hidden="true" />}

    <AiSeoBlocks
      statistics={pricingStats}
      tableData={tableData}
      answers={answers}
      expertQuotes={expertQuotes}
    />

    {
      ((pricingStats?.length ?? 0) > 0 ||
        tableData ||
        (answers?.length ?? 0) > 0 ||
        (expertQuotes?.length ?? 0) > 0) && (
        <hr class="editorial-rule section-rule" aria-hidden="true" />
      )
    }

    <!-- COMPETITOR TIERS -->
    {
      tierRows.length > 0 && (
        <section class="tiers-section" aria-labelledby="tiers-heading">
          <h2 id="tiers-heading" class="editorial-display-m section-title">
            <em>{competitor.name} pricing tiers.</em>
          </h2>
          <div class="tiers-grid">
            {tierRows.map((tier) => (
              <div class="tier-card">
                <p class="editorial-eyebrow tier-card__name">{tier.name}</p>
                <p class="tier-card__price">{tier.price}</p>
                {tier.features.length > 0 && (
                  <ul class="tier-card__features">
                    {tier.features.map((f: string) => (
                      <li>{f}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      tierRows.length > 0 && (
        <hr class="editorial-rule section-rule" aria-hidden="true" />
      )
    }

    <!-- HIDDEN COSTS -->
    {
      hiddenCosts && hiddenCosts.length > 0 && (
        <>
          <section
            class="hidden-costs-section"
            aria-labelledby="hidden-costs-heading"
          >
            <h2
              id="hidden-costs-heading"
              class="editorial-display-m section-title"
            >
              <em>What's not on the pricing page.</em>
            </h2>
            <ul class="hidden-costs-list" role="list">
              {hiddenCosts.map((cost: string) => (
                <li class="hidden-costs-list__item">
                  <span class="hidden-costs-list__marker" aria-hidden="true">
                    -
                  </span>
                  <span>{cost}</span>
                </li>
              ))}
            </ul>
          </section>
          <hr class="editorial-rule section-rule" aria-hidden="true" />
        </>
      )
    }

    <!-- EDITORIAL BODY (MDX content) -->
    <section class="body-section" aria-label="Full pricing analysis">
      <div class="editorial-prose">
        <Content />
      </div>
    </section>

    <hr class="editorial-rule section-rule" aria-hidden="true" />

    <!-- WHY KAIPLAN PRICES DIFFERENTLY -->
    <section class="why-section" aria-labelledby="why-heading">
      <h2 id="why-heading" class="editorial-display-m section-title">
        <em>Why we built Kaiplan's pricing differently.</em>
      </h2>
      <p class="editorial-body why-body">
        Many free wedding planning platforms monetize vendor access, commerce,
        or upgrades instead of charging couples directly - which can optimize
        the product for marketplace participation rather than planning depth.
        Kaiplan earns from couples directly. Starter is
        {PLAN_PRICING.starter.price}. Pro is
        {PLAN_PRICING.pro.price}. Lifetime is {PLAN_PRICING.lifetime.price}, no
        recurring charges. There are no vendor placements, no referral fees, and
        no feature paywalls designed to push you toward a more expensive tier.
        You pay for the tool. The tool stays on your side of the table.
      </p>
    </section>

    <hr class="editorial-rule section-rule" aria-hidden="true" />

    <!-- COMPARISON MATRIX -->
    <section class="matrix-section" aria-labelledby="pricing-matrix-heading">
      <h2 id="pricing-matrix-heading" class="editorial-display-m section-title">
        <em>Pricing compared.</em>
      </h2>

      <div class="matrix-wrap">
        <table
          class="editorial-matrix"
          aria-label={`${competitor.name} vs Kaiplan pricing`}
        >
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col"><em>{competitor.name}</em></th>
              <th scope="col"><em>{siteConfig.name}</em></th>
            </tr>
          </thead>
          <tbody>
            {
              pricingComparisonRows.map((row) => (
                <tr>
                  <td>{row.feature}</td>
                  <td data-column-label={competitor.name}>{row.values[0]}</td>
                  <td data-column-label={siteConfig.name}>{row.values[1]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQS -->
    {
      faqs && faqs.length > 0 && (
        <>
          <hr class="editorial-rule section-rule" aria-hidden="true" />
          <section
            class="faq-section"
            aria-labelledby="pricing-faq-heading"
            id="faq"
          >
            <h2
              id="pricing-faq-heading"
              class="editorial-display-m section-title"
            >
              <em>Common questions about {competitor.name} pricing.</em>
            </h2>
            <ul class="editorial-qa" role="list">
              {faqs.map(
                (
                  item: {
                    question?: string;
                    q?: string;
                    answer?: string;
                    a?: string;
                  },
                  index: number,
                ) => {
                  const q = item.question ?? item.q ?? "";
                  const a = item.answer ?? item.a ?? "";
                  return (
                    <li>
                      <details open={index === 0}>
                        <summary>{q}</summary>
                        <p class="editorial-qa__answer">{a}</p>
                      </details>
                    </li>
                  );
                },
              )}
            </ul>
          </section>
        </>
      )
    }

    <!-- RELATED PAGES -->
    {
      relatedLinks.length > 0 && (
        <>
          <hr class="editorial-rule section-rule" aria-hidden="true" />
          <section class="related-section" aria-labelledby="related-heading">
            <h2 id="related-heading" class="editorial-display-m section-title">
              <em>Related comparisons.</em>
            </h2>
            <ul class="editorial-entry-list" role="list">
              {relatedLinks.map(
                (link: {
                  href: string;
                  title: string;
                  description?: string;
                }) => (
                  <li class="editorial-entry-list__item">
                    <a class="editorial-entry-list__link" href={link.href}>
                      <span class="editorial-entry-list__title">
                        <em>{link.title}</em>
                      </span>
                      {link.description && (
                        <span class="editorial-entry-list__deck">
                          {link.description}
                        </span>
                      )}
                      <span
                        class="editorial-entry-list__cta"
                        aria-hidden="true"
                      >
                        Read &rarr;
                      </span>
                    </a>
                  </li>
                ),
              )}
            </ul>
          </section>
        </>
      )
    }

    <ResourcePillarLink pillar={primaryPillar} />

    <hr class="editorial-rule section-rule" aria-hidden="true" />

    <!-- CLOSING CTA -->
    <section class="closing" aria-label="Open the app">
      <p class="editorial-body closing__line">
        If the pricing tradeoffs are clear,{" "}
        <a class="editorial-link" href={openAppUrl}>
          <em>start your Kaiplan trial &rarr;</em>
        </a>
      </p>
    </section>
  </article>
</LandingLayout>

<style>
  [data-page="pricing-breakdown"] {
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .hero {
    padding-block: clamp(1.5rem, 5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero__headline {
    line-height: 1.02;
  }

  .hero__lede {
    max-width: 52ch;
  }

  .section-rule {
    margin-block: clamp(0.5rem, 2vw, 1rem) 0;
  }

  /* Price at a glance */
  .price-glance {
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .price-glance__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .price-glance__col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .price-glance__label {
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .price-glance__amount {
    font-family: var(--font-editorial-mono);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .price-glance__amount--kaiplan {
    color: var(--terracotta);
  }

  .price-glance__sub {
    margin-top: 0.25rem;
  }

  .price-glance__divider {
    font-family: var(--font-editorial-mono);
    font-size: clamp(1.25rem, 3vw, 2rem);
    color: var(--ink-soft);
    opacity: 0.5;
  }

  .bluf-section {
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }

  .bluf-quote {
    max-width: 44ch;
  }

  .tiers-section,
  .hidden-costs-section,
  .matrix-section,
  .faq-section,
  .related-section,
  .why-section,
  .body-section {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    padding-block-end: clamp(1rem, 3vw, 1.5rem);
  }

  .section-title {
    margin: 0;
  }

  .section-title em {
    font-style: italic;
    font-weight: inherit;
  }

  /* Tier grid */
  .tiers-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    border: 1px solid var(--rule);
  }

  @media (min-width: 48rem) {
    .tiers-grid {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
  }

  .tier-card {
    padding: clamp(1rem, 2.5vw, 1.75rem);
    border-top: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .tier-card:first-child {
    border-top: 0;
  }

  @media (min-width: 48rem) {
    .tier-card {
      border-top: 0;
      border-left: 1px solid var(--rule);
    }

    .tier-card:first-child {
      border-left: 0;
    }
  }

  .tier-card__name {
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .tier-card__price {
    font-family: var(--font-editorial-mono);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .tier-card__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-family: var(--font-editorial-body);
    font-size: 0.875rem;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  .tier-card__features li {
    position: relative;
    padding-left: 1rem;
  }

  .tier-card__features li::before {
    content: "-";
    position: absolute;
    left: 0;
    color: var(--ink);
    font-style: normal;
  }

  /* Hidden costs list */
  .hidden-costs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    max-width: 62ch;
  }

  .hidden-costs-list__item {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.5rem;
    font-family: var(--font-editorial-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .hidden-costs-list__marker {
    font-family: var(--font-editorial-display);
    color: var(--terracotta);
    font-style: italic;
    line-height: 1.65;
  }

  .why-body {
    max-width: 62ch;
  }

  .matrix-wrap {
    overflow-x: auto;
  }

  /* Editorial prose - styles for MDX-rendered body copy */
  .editorial-prose {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 66ch;
  }

  .editorial-prose :global(h2) {
    font-family: var(--font-editorial-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    color: var(--ink);
    margin: 0;
  }

  .editorial-prose :global(h3) {
    font-family: var(--font-editorial-display);
    font-weight: 400;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    color: var(--ink);
    margin: 0;
  }

  .editorial-prose :global(p) {
    font-family: var(--font-editorial-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink);
    margin: 0;
  }

  .editorial-prose :global(ul),
  .editorial-prose :global(ol) {
    font-family: var(--font-editorial-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-soft);
    padding-left: 1.5rem;
    margin: 0;
  }

  .editorial-prose :global(hr) {
    border: 0;
    height: 1px;
    background: var(--rule);
    margin: clamp(1rem, 2.5vw, 1.5rem) 0;
  }

  .editorial-prose :global(a) {
    color: var(--terracotta);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .editorial-prose :global(a:hover),
  .editorial-prose :global(a:focus-visible) {
    color: var(--terracotta-deep);
  }

  /* Editorial entry list - hairline-ruled rows */
  .editorial-entry-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rule);
  }

  .editorial-entry-list__item {
    border-bottom: 1px solid var(--rule);
  }

  .editorial-entry-list__link {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem 2rem;
    padding-block: clamp(0.875rem, 2vw, 1.25rem);
    text-decoration: none;
    color: inherit;
    transition: background 150ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-entry-list__link {
      transition: none;
    }
  }

  .editorial-entry-list__link:hover,
  .editorial-entry-list__link:focus-visible {
    background: var(--paper-deep);
  }

  .editorial-entry-list__link:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 2px;
  }

  @media (min-width: 48rem) {
    .editorial-entry-list__link {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr) auto;
      align-items: baseline;
    }
  }

  .editorial-entry-list__title {
    font-family: var(--font-editorial-display);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    color: var(--ink);
    line-height: 1.3;
  }

  .editorial-entry-list__deck {
    font-family: var(--font-editorial-body);
    font-size: 0.9rem;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  .editorial-entry-list__cta {
    font-family: var(--font-editorial-body);
    font-size: 0.875rem;
    color: var(--terracotta);
    white-space: nowrap;
  }

  .closing {
    padding-block: clamp(1rem, 3vw, 2rem);
  }

  .closing__line {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
  }

  /* Screen-reader only utility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
