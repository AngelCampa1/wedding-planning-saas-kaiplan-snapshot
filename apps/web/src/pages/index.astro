---
import "../styles/global.css";
import { Image } from "astro:assets";
import LandingLayout from "@kaiplan/marketing/layouts/landing-layout.astro";
import { siteConfig, screenshotGallery } from "@/config/site";
import { buildKaiplanHomepageData } from "@/lib/homepage-cro";
import { screenshotPlates } from "@/assets/screenshots/v2/manifest";
import { buildAppSignupUrl } from "@/lib/app-links";

const homepage = buildKaiplanHomepageData({ ...siteConfig, screenshotGallery });
const openAppUrl = buildAppSignupUrl();

const heroPlate = screenshotPlates.find((p) => p.key === "budget-ledger")!;
const guestPlate = screenshotPlates.find((p) => p.key === "guest-list")!;
const seatingPlate = screenshotPlates.find((p) => p.key === "seating-chart")!;
const vendorPlate = screenshotPlates.find((p) => p.key === "vendor-tracker")!;
const websitePlate = screenshotPlates.find((p) => p.key === "wedding-website")!;

const solveCards = [
  {
    title: "The plan gets split across too many places.",
    body: "Budget numbers live in a spreadsheet, guest replies in another tool, seating in a diagram, and vendor notes in your inbox.",
  },
  {
    title: "Free platforms have the wrong incentive.",
    body: "Vendor marketplaces make money from visibility. Kaiplan is paid by couples, so the workspace can stay focused on your plan.",
  },
  {
    title: "Every change creates more reconciliation work.",
    body: "A new quote changes the budget. A new RSVP changes headcount and seating. Connected planning keeps those updates together.",
  },
];

const workflowSteps = [
  {
    label: "Start with the real numbers",
    body: "Add your budget, vendor quotes, deposits, and remaining balances.",
  },
  {
    label: "Bring in the people",
    body: "Track guests, households, RSVP status, dietary notes, and helpers in one workspace.",
  },
  {
    label: "Let changes flow",
    body: "RSVPs feed seating, vendors connect to budget rows, and website replies return to the guest list.",
  },
];

const audienceRows = [
  "Couples planning their own wedding",
  "Partners sharing the planning work",
  "Family helpers who need the right view",
  "Planners supporting one couple's event",
];

const connectedItems = [
  { name: "Budget", detail: "Quotes, paid amounts, and balances" },
  { name: "Guests", detail: "Households, RSVP status, and meal notes" },
  { name: "Vendors", detail: "Contracts, notes, and contact details" },
  { name: "Seating", detail: "Tables built from confirmed guests" },
  { name: "Website", detail: "Published details with RSVP links" },
  { name: "Checklist", detail: "Milestones tied to the wedding date" },
];

const pricingTiers = homepage.pricing.tiers;
const faqItems = homepage.faq.items;
---

<LandingLayout config={siteConfig} description={siteConfig.metaDescription}>
  <article class="clarity-shell" data-page="home">
    <section class="hero" aria-labelledby="hero-headline">
      <div class="hero__copy">
        <h1 id="hero-headline" class="editorial-display-xl hero__headline">
          {homepage.hero.headline}
        </h1>
        <p class="editorial-lede hero__lede">{homepage.hero.subheadline}</p>
        <div class="hero__actions" aria-label="Primary actions">
          <a class="clarity-button clarity-button--primary" href={openAppUrl}>
            {homepage.hero.primaryCta.text}
          </a>
          <a
            class="clarity-button clarity-button--secondary"
            href={homepage.hero.secondaryCta.target}
          >
            {homepage.hero.secondaryCta.text}
          </a>
        </div>
        <p class="hero__trust">{homepage.hero.trustSignal}</p>
      </div>

      <div class="product-stack" aria-label="Kaiplan workspace preview">
        <figure class="product-stack__primary">
          <Image
            src={heroPlate.srcLarge}
            alt={heroPlate.alt}
            widths={[640, 960, 1280]}
            sizes="(min-width: 72rem) 52vw, 100vw"
            loading="eager"
          />
          <figcaption>{heroPlate.caption}</figcaption>
        </figure>
        <div class="product-stack__rail" aria-hidden="true">
          <span>Budget</span>
          <span>Guests</span>
          <span>Vendors</span>
          <span>Seating</span>
          <span>RSVP</span>
        </div>
      </div>
    </section>

    <section
      class="clarity-section clarity-section--solve"
      aria-labelledby="solve-heading"
      id="what-kaiplan-solves"
    >
      <div class="section-heading">
        <p class="editorial-eyebrow">What we solve</p>
        <h2 id="solve-heading" class="editorial-display-l">
          What Kaiplan solves
        </h2>
        <p class="editorial-lede">
          Wedding planning gets hard when every decision changes three other
          lists. Kaiplan gives the plan one source of truth.
        </p>
      </div>
      <div class="solve-grid">
        {
          solveCards.map((card) => (
            <article class="clarity-card">
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="clarity-section clarity-section--workflow"
      aria-labelledby="workflow-heading"
      id="how-it-works"
    >
      <div class="section-heading">
        <p class="editorial-eyebrow">How we solve it</p>
        <h2 id="workflow-heading" class="editorial-display-l">
          How Kaiplan works
        </h2>
        <p class="editorial-lede">
          Start with the planning data you already have. Kaiplan turns it into a
          connected workspace for the rest of the engagement.
        </p>
      </div>
      <ol class="workflow-list" role="list">
        {
          workflowSteps.map((step, index) => (
            <li>
              <span class="workflow-list__number">{index + 1}</span>
              <div>
                <h3>{step.label}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="clarity-section clarity-section--audience"
      aria-labelledby="audience-heading"
      id="who-it-is-for"
    >
      <div class="audience-copy">
        <p class="editorial-eyebrow">Who it is for</p>
        <h2 id="audience-heading" class="editorial-display-l">
          Built for couples and their planning circle
        </h2>
        <p class="editorial-lede">
          Kaiplan is for the people responsible for one wedding: the couple,
          their partner, the family members helping, and the planner who needs
          clean information instead of screenshots.
        </p>
      </div>
      <ul class="audience-list" role="list">
        {audienceRows.map((row) => <li>{row}</li>)}
      </ul>
    </section>

    <section
      class="clarity-section clarity-section--connected"
      aria-labelledby="connected-heading"
      id="features"
    >
      <div class="section-heading">
        <p class="editorial-eyebrow">The connected workspace</p>
        <h2 id="connected-heading" class="editorial-display-l">
          Everything stays connected
        </h2>
        <p class="editorial-lede">
          The product is not six separate tools under one logo. The important
          wedding data moves with you.
        </p>
      </div>

      <div class="connected-layout">
        <div class="connected-map" role="list">
          {
            connectedItems.map((item) => (
              <article class="connected-item" role="listitem">
                <h3>{item.name}</h3>
                <p>{item.detail}</p>
              </article>
            ))
          }
        </div>
        <div class="connected-plates">
          {
            [guestPlate, seatingPlate, vendorPlate, websitePlate].map(
              (plate) => (
                <figure>
                  <Image
                    src={plate.src}
                    alt={plate.alt}
                    widths={[320, 480, 640]}
                    sizes="(min-width: 64rem) 22vw, 44vw"
                    loading="lazy"
                  />
                </figure>
              ),
            )
          }
        </div>
      </div>
    </section>

    <section
      class="clarity-section clarity-section--pricing"
      aria-labelledby="pricing-heading"
      id="pricing"
    >
      <div class="section-heading">
        <p class="editorial-eyebrow">Pricing</p>
        <h2 id="pricing-heading" class="editorial-display-l">
          Simple pricing for one wedding
        </h2>
        <p class="editorial-lede">{homepage.pricing.intro}</p>
      </div>

      <div class="pricing-grid" role="list">
        {
          pricingTiers.map((tier) => (
            <article
              class:list={[
                "pricing-card",
                tier.highlighted && "pricing-card--highlighted",
              ]}
              role="listitem"
            >
              {tier.highlighted && (
                <p class="pricing-card__label">Most complete</p>
              )}
              <h3>{tier.name}</h3>
              <p class="pricing-card__price">{tier.price}</p>
              {tier.description && (
                <p class="pricing-card__body">{tier.description}</p>
              )}
              <ul role="list">
                {tier.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <a
                class="clarity-button clarity-button--secondary"
                href={tier.ctaTarget}
              >
                {tier.ctaText}
              </a>
            </article>
          ))
        }
      </div>
      <p class="pricing-note">{homepage.pricing.helperText}</p>
    </section>

    <section
      class="clarity-section clarity-section--faq"
      aria-labelledby="faq-heading"
    >
      <div class="section-heading">
        <p class="editorial-eyebrow">Questions</p>
        <h2 id="faq-heading" class="editorial-display-l">
          {homepage.faq.heading}
        </h2>
      </div>
      <ul class="editorial-qa" role="list">
        {
          faqItems.map((item, index) => (
            <li>
              <details open={index === 0}>
                <summary>{item.q}</summary>
                <p class="editorial-qa__answer">{item.a}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</LandingLayout>

<style>
  [data-page="home"] {
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(4rem, 7vw, 6rem);
  }

  .clarity-shell {
    width: min(100% - 2rem, 1180px);
    margin-inline: auto;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    min-height: min(680px, calc(100vh - 8rem));
    padding-block: clamp(1.5rem, 4vw, 3.5rem);
  }

  .hero__copy {
    max-width: 46rem;
  }

  .hero__headline {
    max-width: 11ch;
    font-size: clamp(3.75rem, 7vw, 6.5rem);
    line-height: 0.96;
  }

  .hero__lede {
    margin-top: 1.5rem;
    max-width: 42rem;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero__trust {
    margin: 1.25rem 0 0;
    max-width: 36rem;
    font-family: var(--font-editorial-body);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .clarity-button {
    display: inline-flex;
    min-height: 2.875rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--ink);
    padding: 0.8rem 1.1rem;
    font-family: var(--font-editorial-body);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .clarity-button--primary {
    background: var(--ink);
    color: var(--paper);
  }

  .clarity-button--secondary {
    background: transparent;
    color: var(--ink);
  }

  .clarity-button:hover {
    border-color: var(--terracotta);
    background: var(--terracotta);
    color: var(--paper);
  }

  .product-stack {
    position: relative;
    display: grid;
    gap: 1rem;
  }

  .product-stack__primary {
    margin: 0;
    border: 1px solid var(--rule);
    background: #fff;
    box-shadow: 0 24px 60px rgb(23 19 17 / 12%);
  }

  .product-stack__primary img {
    display: block;
    width: 100%;
    height: auto;
  }

  .product-stack__primary figcaption {
    border-top: 1px solid var(--rule);
    padding: 0.8rem 1rem;
    font-family: var(--font-editorial-body);
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .product-stack__rail {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1px solid var(--rule);
    background: rgb(255 255 255 / 72%);
  }

  .product-stack__rail span {
    padding: 0.75rem 0.5rem;
    border-right: 1px solid var(--rule);
    text-align: center;
    font-family: var(--font-editorial-body);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .product-stack__rail span:last-child {
    border-right: 0;
  }

  .clarity-section {
    padding-block: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--rule);
  }

  .section-heading {
    max-width: 48rem;
  }

  .section-heading .editorial-display-l,
  .audience-copy .editorial-display-l {
    margin-top: 0.75rem;
  }

  .section-heading .editorial-lede,
  .audience-copy .editorial-lede {
    margin-top: 1rem;
    color: var(--ink-soft);
  }

  .solve-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }

  .clarity-card,
  .connected-item,
  .pricing-card {
    border: 1px solid var(--rule);
    background: rgb(255 255 255 / 64%);
  }

  .clarity-card {
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .clarity-card h3,
  .workflow-list h3,
  .connected-item h3,
  .pricing-card h3 {
    margin: 0;
    font-family: var(--font-editorial-display);
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    line-height: 1.08;
    color: var(--ink);
  }

  .clarity-card p,
  .workflow-list p,
  .connected-item p,
  .pricing-card__body,
  .pricing-card li,
  .pricing-note {
    margin: 0.8rem 0 0;
    font-family: var(--font-editorial-body);
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .workflow-list {
    display: grid;
    gap: 1px;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .workflow-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--paper);
  }

  .workflow-list__number {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-editorial-mono);
    font-size: 0.8rem;
  }

  .clarity-section--audience {
    display: grid;
    gap: 2rem;
  }

  .audience-list {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .audience-list li {
    padding: 1rem 1.25rem;
    background: #fff;
    font-family: var(--font-editorial-body);
    font-weight: 700;
    color: var(--ink);
  }

  .connected-layout {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }

  .connected-map {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .connected-item {
    padding: 1.25rem;
  }

  .connected-plates {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .connected-plates figure {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: #fff;
  }

  .connected-plates img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .pricing-card--highlighted {
    border-color: var(--terracotta);
    box-shadow: inset 0 0 0 2px rgb(176 67 42 / 18%);
  }

  .pricing-card__label {
    margin: 0;
    font-family: var(--font-editorial-body);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--terracotta);
  }

  .pricing-card__price {
    margin: 0;
    font-family: var(--font-editorial-display);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    color: var(--ink);
  }

  .pricing-card ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding-left: 1.1rem;
  }

  .pricing-card .clarity-button {
    margin-top: auto;
  }

  .pricing-note {
    max-width: 48rem;
    margin-top: 1.25rem;
  }

  .clarity-section--faq .editorial-qa {
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .solve-grid,
    .pricing-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .connected-map {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    }

    .clarity-section--audience,
    .connected-layout {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  @media (max-width: 42rem) {
    .hero__headline {
      max-width: 11ch;
    }

    .product-stack__rail {
      grid-template-columns: 1fr;
    }

    .product-stack__rail span {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }

    .product-stack__rail span:last-child {
      border-bottom: 0;
    }

    .connected-plates {
      grid-template-columns: 1fr;
    }
  }
</style>
