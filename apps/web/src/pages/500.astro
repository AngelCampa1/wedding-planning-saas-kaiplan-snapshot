---
import "../styles/global.css";
import LandingLayout from "@kaiplan/marketing/layouts/landing-layout.astro";
import { siteConfig } from "@/config/site";

Astro.response.status = 500;
Astro.response.statusText = "Internal Server Error";
---

<LandingLayout
  config={siteConfig}
  title={`Server Error — ${siteConfig.name}`}
  description={`Something went wrong while loading ${siteConfig.name}.`}
  canonicalPath="/500"
>
  <section
    style="
      min-height: 60vh;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      padding: clamp(5rem, 12vw, 10rem) clamp(1rem, 4vw, 3rem);
      max-width: 80rem;
      margin-inline: auto;
    "
  >
    <h1
      class="editorial-display-xl editorial-italic"
      style="color: var(--ink);"
    >
      Something went sideways.
    </h1>
    <p class="editorial-body" style="margin-top: 2rem;">
      Try refreshing. If it persists, write to <a
        class="editorial-link"
        href={`mailto:${siteConfig.contactEmail}`}
        ><em>{siteConfig.contactEmail}</em></a
      >.
    </p>
  </section>
</LandingLayout>
