---
import "../../../styles/global.css";
import ArticleLayout from "@kaiplan/marketing/layouts/article-layout.astro";
import FaqSection from "@kaiplan/marketing/components/faq-section.astro";
import FunnelCta from "@kaiplan/marketing/components/funnel-cta.astro";
import InlineSignup from "@kaiplan/marketing/components/inline-signup.astro";
import DataTableBlock from "@kaiplan/marketing/seo/data-table-block.astro";
import DefinitionBlock from "@kaiplan/marketing/seo/definition-block.astro";
import ProsConsBlock from "@kaiplan/marketing/seo/pros-cons-block.astro";
import AnswerBlock from "@kaiplan/marketing/seo/answer-block.astro";
import ExpertQuote from "@kaiplan/marketing/seo/expert-quote.astro";
import StatisticCitation from "@kaiplan/marketing/seo/statistic-citation.astro";
import WeddingPlanningWithoutVendorAdsContent, {
  frontmatter,
  getHeadings,
} from "../../../content/guides/wedding-planning-without-vendor-ads.md";
import { siteConfig } from "@/config/site";
import { buildGuideBreadcrumbs } from "@/lib/breadcrumbs";
import { buildGuideInlineSignupCopy } from "@/lib/guide-inline-signup";
import {
  buildEntrySeoProps,
  buildOptionalHowToSchema,
} from "@/lib/page-helpers";

const {
  title,
  description,
  bluf,
  buyerStage,
  publishedAt,
  updatedAt,
  faqs,
  definitions,
  answers,
  expertQuotes,
  statistics,
  tableData,
} = frontmatter;
const canonicalPath = "/resources/guides/wedding-planning-without-vendor-ads";
const breadcrumbs = buildGuideBreadcrumbs(title, canonicalPath);
const seoProps = buildEntrySeoProps(frontmatter);
const headings = getHeadings();
const inlineSignupCopy = buildGuideInlineSignupCopy(canonicalPath);
const howToSchema = buildOptionalHowToSchema(
  frontmatter.steps,
  title,
  description,
);

type DefinitionItem = { term: string; definition: string };
type StatisticItem = { stat: string; source: string; sourceUrl?: string };
type AnswerItem = {
  q?: string;
  a?: string;
  question?: string;
  answer?: string;
};
type ExpertQuoteItem = {
  quote: string;
  personName: string;
  jobTitle?: string;
  organization?: string;
};
type ProsConsItem = { subject: string; pros: string[]; cons: string[] };
---

<ArticleLayout
  title={title}
  description={description}
  bluf={bluf}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  canonicalPath={canonicalPath}
  config={siteConfig}
  breadcrumbs={breadcrumbs}
  buyerStage={buyerStage}
  schemas={howToSchema ? [howToSchema] : []}
  headings={headings}
  noindex={seoProps.noindex}
  answers={seoProps.answers}
  faqs={seoProps.faqs}
>
  {
    definitions?.map((definition: DefinitionItem) => (
      <DefinitionBlock
        term={definition.term}
        definition={definition.definition}
      />
    ))
  }

  {
    statistics?.map((s: StatisticItem) => (
      <StatisticCitation
        stat={s.stat}
        source={s.source}
        sourceUrl={s.sourceUrl}
      />
    ))
  }

  {
    tableData && (
      <DataTableBlock
        name={tableData.name}
        columns={tableData.columns}
        rows={tableData.rows}
        description={tableData.description}
      />
    )
  }

  <WeddingPlanningWithoutVendorAdsContent />

  {
    answers?.map((answer: AnswerItem) => (
      <AnswerBlock
        question={answer.q ?? answer.question ?? ""}
        answer={answer.a ?? answer.answer ?? ""}
      />
    ))
  }

  {
    expertQuotes?.map((quote: ExpertQuoteItem) => (
      <ExpertQuote
        quote={quote.quote}
        personName={quote.personName}
        jobTitle={quote.jobTitle}
        organization={quote.organization}
      />
    ))
  }

  {
    frontmatter.proscons?.map((item: ProsConsItem) => (
      <ProsConsBlock subject={item.subject} pros={item.pros} cons={item.cons} />
    ))
  }

  <InlineSignup
    apiUrl={Astro.url.origin}
    sourcePage={inlineSignupCopy.sourcePage}
    surveyQuestions={siteConfig.survey.questions}
    heading={inlineSignupCopy.heading}
    subtext={inlineSignupCopy.subtext}
    buttonText={inlineSignupCopy.buttonText}
    ctaTarget={inlineSignupCopy.ctaTarget}
    subtitle={inlineSignupCopy.subtitle}
    whatHappensNext={inlineSignupCopy.whatHappensNext}
    surveyPreview={inlineSignupCopy.surveyPreview}
    productName={siteConfig.name}
    productDomain={siteConfig.domain}
    variant={inlineSignupCopy.variant}
  />

  <FaqSection faqs={faqs} heading="Common Questions" />

  <FunnelCta
    stage={buyerStage}
    funnel={siteConfig.funnel}
    heading="If you want planning without vendor ads, start the trial and choose a plan later."
    benefitBullets={siteConfig.copy?.funnelCta?.benefitBullets}
    trustNote={siteConfig.funnel.ctaSubtitle}
  />
</ArticleLayout>
