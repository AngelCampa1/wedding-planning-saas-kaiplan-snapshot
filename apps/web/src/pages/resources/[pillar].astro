---
export const prerender = true;
import "../../styles/global.css";
import { getCollection } from "astro:content";
import LandingLayout from "@kaiplan/marketing/layouts/landing-layout.astro";
import FaqSection from "@kaiplan/marketing/components/faq-section.astro";
import { siteConfig } from "@/config/site";
import { contentEntrySlug } from "@/lib/content-entry";
import {
  getPillarResources,
  getResourcePillars,
  type PillarResourceItem,
} from "@/lib/resource-pillars";

export function getStaticPaths() {
  return getResourcePillars().map((pillar) => ({
    params: { pillar: pillar.slug },
    props: { pillar },
  }));
}

const { pillar } = Astro.props;

const [
  alternatives,
  comparisons,
  pricingBreakdowns,
  listicles,
  guides,
  leadMagnets,
] = await Promise.all([
  getCollection("alternatives"),
  getCollection("comparisons"),
  getCollection("pricing-breakdowns"),
  getCollection("listicles"),
  getCollection("guides"),
  getCollection("lead-magnets"),
]);

const resources = dedupeResourcesByHref([
  ...guides.filter(isIndexable).map((entry) => ({
    href: `/resources/guides/${contentEntrySlug(entry)}/`,
    title: entry.data.title,
    description: entry.data.description,
    publishedAt: entry.data.publishedAt,
    type: "Planning Guides",
  })),
  ...listicles.filter(isIndexable).map((entry) => ({
    href: `/resources/best/${contentEntrySlug(entry)}/`,
    title: entry.data.title,
    description: entry.data.description,
    publishedAt: entry.data.publishedAt,
    type: "Best Apps & Tools",
  })),
  ...alternatives.filter(isIndexable).map((entry) => ({
    href: `/compare/alternatives/${entry.data.competitor.slug}/`,
    title: entry.data.title,
    description: entry.data.description,
    publishedAt: entry.data.publishedAt,
    type: "Alternatives",
  })),
  ...comparisons.filter(isIndexable).map((entry) => ({
    href: `/compare/versus/${contentEntrySlug(entry)}/`,
    title: entry.data.title,
    description: entry.data.description,
    publishedAt: entry.data.publishedAt,
    type: "Head-to-Head Comparisons",
  })),
  ...pricingBreakdowns.filter(isIndexable).map((entry) => ({
    href: `/compare/pricing/${contentEntrySlug(entry)}/`,
    title: entry.data.title,
    description: entry.data.description,
    publishedAt: entry.data.publishedAt,
    type: "Pricing Breakdowns",
  })),
  ...leadMagnets.filter(isIndexable).map((entry) => ({
    href: `/free/${contentEntrySlug(entry)}/`,
    title: entry.data.title,
    description: entry.data.description,
    publishedAt: entry.data.publishedAt,
    type: "Free Tools & Templates",
  })),
]);

function isIndexable(entry: { data: { noindex?: boolean } }): boolean {
  return entry.data.noindex !== true;
}

function dedupeResourcesByHref(
  items: PillarResourceItem[],
): PillarResourceItem[] {
  const byHref = new Map<string, PillarResourceItem>();

  for (const item of items) {
    if (!byHref.has(item.href)) {
      byHref.set(item.href, item);
    }
  }

  return [...byHref.values()];
}

const pillarResources = getPillarResources(pillar.slug, resources).sort(
  (a, b) =>
    new Date(b.publishedAt ?? "1970-01-01").getTime() -
    new Date(a.publishedAt ?? "1970-01-01").getTime(),
);
const groupedResources = Array.from(
  pillarResources.reduce((groups, resource) => {
    const group = groups.get(resource.type) ?? [];
    group.push(resource);
    groups.set(resource.type, group);
    return groups;
  }, new Map<string, PillarResourceItem[]>()),
);

function slugifyId(value: string): string {
  return value
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}
---

<LandingLayout
  config={siteConfig}
  canonicalPath={pillar.href}
  title={`${pillar.title} | Kaiplan Resources`}
  description={pillar.description}
>
  <article class="editorial-shell pillar-page">
    <header class="pillar-hero">
      <p class="editorial-eyebrow">{pillar.eyebrow}</p>
      <h1 class="editorial-display-l pillar-hero__headline">
        <em>{pillar.title}</em>
      </h1>
      <p class="editorial-lede pillar-hero__lede">{pillar.description}</p>
    </header>

    <hr class="editorial-rule pillar-rule" aria-hidden="true" />

    {
      groupedResources.map(([type, items]) => (
        <section
          class="pillar-section"
          aria-labelledby={`${slugifyId(type)}-heading`}
        >
          <h2
            id={`${slugifyId(type)}-heading`}
            class="editorial-eyebrow pillar-section__label"
          >
            {type}
          </h2>
          <p class="editorial-caption pillar-section__count">
            {items.length} resource{items.length !== 1 ? "s" : ""}
          </p>
          <ol class="pillar-list" role="list">
            {items.map((item) => (
              <li class="pillar-list__item">
                <a class="pillar-list__link" href={item.href}>
                  <span class="pillar-list__title">
                    <em>{item.title}</em>
                  </span>
                  {item.description && (
                    <span class="pillar-list__deck">{item.description}</span>
                  )}
                  <span class="pillar-list__cta" aria-hidden="true">
                    Read &rarr;
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <hr class="editorial-rule pillar-rule" aria-hidden="true" />

    <FaqSection faqs={pillar.faqs} heading="Common Questions" />
  </article>
</LandingLayout>

<style>
  .pillar-page {
    padding-top: clamp(2rem, 5vw, 4rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .pillar-hero {
    padding-block: clamp(2rem, 6vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pillar-hero__headline {
    margin-top: 0.5rem;
    max-width: 28ch;
  }

  .pillar-hero__lede {
    max-width: 56ch;
  }

  .pillar-rule {
    margin-block: 0;
  }

  .pillar-section {
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .pillar-section__label {
    margin-bottom: 0.25rem;
  }

  .pillar-section__count {
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  .pillar-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rule);
  }

  .pillar-list__item {
    border-bottom: 1px solid var(--rule);
  }

  .pillar-list__link {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem 2rem;
    padding-block: clamp(1rem, 2vw, 1.35rem);
    color: inherit;
    text-decoration: none;
  }

  .pillar-list__link:hover,
  .pillar-list__link:focus-visible {
    background: var(--paper-deep);
    outline: none;
  }

  .pillar-list__link:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 2px;
  }

  .pillar-list__title {
    font-family: var(--font-editorial-display);
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    line-height: 1.25;
    color: var(--ink);
  }

  .pillar-list__deck {
    font-family: var(--font-editorial-body);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .pillar-list__cta {
    font-family: var(--font-editorial-body);
    font-size: 0.9rem;
    color: var(--terracotta);
    white-space: nowrap;
  }

  @media (min-width: 48rem) {
    .pillar-list__link {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr) auto;
      align-items: baseline;
    }
  }
</style>
