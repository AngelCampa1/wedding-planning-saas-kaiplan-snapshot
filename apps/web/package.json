{
  "name": "@kaiplan/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "prebuild": "pnpm exec tsx ../../scripts/build-lead-magnet-pdfs.ts",
    "build": "astro build",
    "postbuild": "pnpm exec tsx ../../scripts/patch-astro-cloudflare-preview-config.ts",
    "build:pdfs": "pnpm exec tsx ../../scripts/build-lead-magnet-pdfs.ts",
    "d1:migrate:prod": "pnpm exec wrangler d1 migrations apply kaiplan-db --remote --config wrangler.jsonc",
    "d1:backfill:prod": "pnpm exec tsx ../../scripts/backfill-marketing-unsubscribes.ts",
    "deploy": "pnpm exec tsx ../../scripts/validate-cloudflare-web-config.ts && pnpm exec tsx ../../scripts/deploy-lead-magnet-pdfs.ts && pnpm run build && pnpm run d1:migrate:prod && pnpm run d1:backfill:prod && pnpm exec tsx ../../scripts/patch-wrangler-custom-domains.ts && pnpm exec wrangler deploy --config dist/server/wrangler.json",
    "lint": "pnpm exec eslint . --ext .ts,.astro,.mjs",
    "preview": "astro preview --host",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.7",
    "@astrojs/react": "^4.4.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.6.0",
    "@kaiplan/knowledge": "workspace:*",
    "@kaiplan/marketing": "workspace:*",
    "@kaiplan/marketing-api": "workspace:*",
    "@kaiplan/shared": "workspace:*",
    "@sentry/astro": "^10.49.0",
    "astro": "^6.3.5",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.1.16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.3",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.7",
    "vitest": "^4.1.3",
    "wrangler": "^4.85.0"
  }
}
