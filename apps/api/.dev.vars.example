# image upload endpoint returns a 503; every other request is unaffected.
CLOUDFLARE_IMAGES_ACCOUNT_ID=your-account-id
CLOUDFLARE_IMAGES_API_TOKEN=your-api-token
CLOUDFLARE_IMAGES_DELIVERY_BASE_URL=https://imagedelivery.net/your-hash
CLOUDFLARE_IMAGES_DIRECT_UPLOAD_TTL_SECONDS=600
FEEDBACK_RECIPIENT_EMAIL=
TURNSTILE_SECRET_KEY=
PUBLIC_RSVP_HONEYPOT_FIELD=website
PUBLIC_RSVP_TURNSTILE_FIELD=turnstileToken
