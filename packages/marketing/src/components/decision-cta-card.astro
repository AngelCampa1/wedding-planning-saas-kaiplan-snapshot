---
import { CheckIconHidden } from "../lib/icons";
import { buildDecisionCtaCardModel } from "../lib/decision-cta-card";
import type { DecisionCtaCardProps } from "../types";

const model = buildDecisionCtaCardModel(Astro.props as DecisionCtaCardProps);
---

<section
  class="my-10 rounded-[calc(var(--radius-lg)+2px)] border border-[color-mix(in_srgb,var(--color-neutral-300)_42%,transparent)] bg-[color-mix(in_srgb,var(--surface-primary)_88%,var(--surface-elevated))] p-6 shadow-[var(--shadow-card)]"
  data-section="decision-cta-card"
>
  <div class="flex flex-col gap-5">
    <div class="space-y-3">
      <p
        class="font-mono text-xs uppercase tracking-[0.22em] text-[var(--color-brand-muted)]"
      >
        Decision Support
      </p>
      <h2
        class="font-heading text-[length:var(--text-subheading)] font-bold text-brand-text"
      >
        {model.heading}
      </h2>
      <p
        class="text-[length:var(--text-body)] leading-relaxed text-brand-muted"
      >
        {model.subtext}
      </p>
    </div>

    {
      model.bullets.length > 0 && (
        <ul class="space-y-2">
          {model.bullets.map((bullet) => (
            <li class="flex items-start gap-2 text-[length:var(--text-caption)] text-brand-text">
              <span
                class="mt-0.5 inline-flex h-[var(--icon-md)] w-[var(--icon-md)] shrink-0 items-center justify-center rounded-full bg-[var(--color-accent-500)] text-[var(--color-neutral-50)]"
                aria-hidden="true"
                set:html={CheckIconHidden}
              />
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
      )
    }

    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href={model.primaryCta.target}
        class="btn-primary text-center no-underline w-full sm:w-auto"
        {...model.primaryCta.analyticsAttributes}
      >
        {model.primaryCta.text}
      </a>
      {
        model.secondaryCta && (
          <a
            href={model.secondaryCta.target}
            class="btn-secondary text-center no-underline w-full sm:w-auto"
            {...model.secondaryCta.analyticsAttributes}
          >
            {model.secondaryCta.text}
          </a>
        )
      }
    </div>
  </div>
</section>
