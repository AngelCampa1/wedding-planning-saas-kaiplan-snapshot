---
interface Props {
  text: string;
  label?: string;
}
const { text, label = "TLDR" } = Astro.props;
---

<div
  class="bluf-block rounded-[var(--radius-md)] border-l-4 border-[var(--color-accent-500)] bg-[var(--color-accent-50)] px-4 py-4 sm:px-6 mb-8"
  role="note"
>
  <p
    class="font-mono text-[length:var(--text-caption)] uppercase tracking-widest text-[var(--color-accent-700)] mb-1.5"
  >
    {label}
  </p>
  <p
    class="text-[length:var(--text-body-lg)] font-medium leading-relaxed text-brand-text"
  >
    {text}
  </p>
</div>
