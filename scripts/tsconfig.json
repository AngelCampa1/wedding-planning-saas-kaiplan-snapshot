{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "types": ["@cloudflare/workers-types", "node", "vitest/globals"]
  },
  "include": ["*.ts", "lib/**/*.ts"]
}
