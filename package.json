{
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@cloudflare/workers-types": "^4.20260405.1",
    "@eslint/js": "^10.0.1",
    "@kaiplan/lead-magnet-pdf": "workspace:*",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.19.17",
    "@vitest/coverage-v8": "^4.1.3",
    "astro-eslint-parser": "1.4.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.4.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "marked": "^15.0.12",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.21.0",
    "turbo": "^2.9.5",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.3"
  },
  "scripts": {
    "prepare": "husky",
    "e2e:browser": "pnpm exec playwright test --config e2e/playwright.config.ts",
    "e2e:mobile": "pnpm exec playwright test --config e2e/playwright.config.ts --project=iphone-12 --project=pixel-7",
    "e2e:live": "pnpm exec playwright test --config e2e/playwright.live.config.ts",
    "e2e:db:reset": "pnpm exec tsx scripts/local-e2e-db.ts reset",
    "e2e:db:start": "pnpm exec tsx scripts/local-e2e-db.ts start",
    "e2e:db:stop": "pnpm exec tsx scripts/local-e2e-db.ts stop",
    "e2e:prepare": "pnpm exec tsx scripts/prepare-local-e2e.ts",
    "e2e:smoke": "pnpm exec tsx scripts/run-local-smoke.ts",
    "deploy:api": "pnpm --filter @kaiplan/api run deploy",
    "deploy:app": "pnpm --filter @kaiplan/app run deploy",
    "deploy:web": "pnpm --filter @kaiplan/web run deploy",
    "deploy:touched": "pnpm exec tsx scripts/deploy-touched.ts",
    "backfill:lead-magnet-sequencer": "pnpm exec tsx scripts/backfill-lead-magnet-sequencer.ts",
    "cloudflare:cleanup-marketing": "pnpm exec tsx scripts/cleanup-cloudflare-marketing.ts",
    "lint": "pnpm exec turbo lint",
    "typecheck": "pnpm exec turbo typecheck && pnpm run typecheck:scripts",
    "typecheck:scripts": "pnpm --filter @kaiplan/marketing-api exec tsc -p ../../scripts/tsconfig.json --noEmit",
    "test:coverage": "pnpm exec turbo test:coverage",
    "test:scripts": "pnpm exec vitest run --config scripts/vitest.config.ts",
    "audit:links": "pnpm exec tsx scripts/audit-links.ts apps/web/dist",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run test:scripts && pnpm --filter @kaiplan/web run build && pnpm run audit:links -- --skip-external && pnpm run e2e:browser"
  },
  "packageManager": "pnpm@10.33.0"
}
